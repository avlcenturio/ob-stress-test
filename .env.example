# Copy to .env and fill in. Used by the Docker compose files.
# Tenant profiles and test profiles are set up in the web UI, not here.

# --- Server (docker-compose.server.yml / docker-compose.deploy.yml) ---
OB_BIND=0.0.0.0                 # 127.0.0.1 = this machine only (default); 0.0.0.0 = reachable from other machines
OB_WEB_USER=admin               # login for every page (leave both empty to switch the login off)
OB_WEB_PASSWORD=

# --- Deployment from a registry (docker-compose.deploy.yml) ---
OB_IMAGE=yourname/ozone-ob-stress-test:latest

# --- Optional, for runs without the web UI ---
# OB_PROFILE=Peak AIS           # test profile to run
# OB_USER_TPS=2                 # requests per second per user (overrides the profile)
